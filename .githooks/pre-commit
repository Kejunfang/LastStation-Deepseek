#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

# Tests must exercise exactly what is being committed.
if ! git diff --quiet -- .; then
  echo "[pre-commit] FAIL: unstaged changes exist. Stage everything that belongs to this commit."
  git diff --stat
  exit 1
fi

untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  echo "[pre-commit] FAIL: untracked files exist. Add them or ignore them before committing."
  echo "$untracked"
  exit 1
fi

if [ ! -d node_modules/playwright ]; then
  echo "[pre-commit] FAIL: dependencies missing. Run: npm install"
  exit 1
fi

echo "[pre-commit] running full test suite (static + browser smoke)..."
npm test
echo "[pre-commit] OK: all tests passed."
